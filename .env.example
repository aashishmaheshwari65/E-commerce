# ==============================================================================
# E-Commerce Data Engineering & AI Analytics Platform - Environment Configuration
# Copy this file to .env and replace placeholder values with your actual secrets.
# NEVER commit .env to version control!
# ==============================================================================

# Database / Supabase PostgreSQL Connection
# Used by ingestion, validation, etl, and database tests
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_KEY=[YOUR_SUPABASE_ANON_OR_SERVICE_KEY]

# Optional direct connection attributes
host=[HOST]
port=5432
database=postgres
user=postgres.[YOUR_PROJECT_REF]
DB_PASSWORD=[PASSWORD]

# FastAPI Service Configuration
# Used by api/config.py and docker-compose.yml
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ML_DATA_ROOT=/app/data
ML_MODEL_ROOT=/app/data/models
ML_FEATURE_ROOT=/app/data/ml_pipeline/features

# Apache Airflow Configuration (for docker-compose.airflow.yml)
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False

# Apache Kafka Configuration (for docker-compose.kafka.yml)
# Container network address: kafka:9092 | Windows host address: localhost:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Apache Spark Configuration (for docker-compose.spark.yml)
SPARK_MASTER_URL=spark://spark-master:7077
